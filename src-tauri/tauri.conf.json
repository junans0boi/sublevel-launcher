{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sublevel",
  "version": "0.1.8",
  "identifier": "kr.steady2vivid.sublevel.launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Sublevel", "width": 1040, "height": 656, "resizable": false, "center": true, "decorations": false }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["sublevel"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFOTBERTk0QUU1MUNEREMKUldUY3pWR3VsTjZRdnBPcGw4d2lnWHB4Z0hJMWR0NXl3czlTSTA0MHFiYklSTytzRG05Q3B2b0YK",
      "endpoints": ["https://sublevel.steady2vivid.kro.kr/launcher/update.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "macOS": { "signingIdentity": "-" },
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
