{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sublevel",
  "version": "0.1.0",
  "identifier": "kr.steady2vivid.sublevel.launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Sublevel", "width": 960, "height": 600, "resizable": false, "center": true }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
